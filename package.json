{
  "name": "fives-rewards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:prod": "cross-env CLOUDFLARE_ENV=production vite build",
    "build:native": "vite build --config vite.native.config.ts --mode native && node ./scripts/native-build-check.mjs",
    "cap:sync": "npm run build:native && cap sync android && node ./scripts/android-project-check.mjs",
    "cap:android": "cap open android",
    "preview": "npm run build && vite preview",
    "deploy": "node -e \"console.error('Blocked: npm run deploy is disabled to prevent accidental non-production Wrangler deployment against shared resources. Use npm run deploy:prod for intentional production releases.'); process.exit(1)\"",
    "deploy:prod": "npm run build:prod && wrangler deploy --env production",
    "lint": "npm run typecheck",
    "test": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/phase13-smoke.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/auth-regression-smoke.ps1 && node ./scripts/account-deletion-smoke.mjs && node ./scripts/points-smoke.mjs && node ./scripts/webpush-payload-smoke.mjs && node ./scripts/menu-media-cache-smoke.mjs && node ./scripts/promotion-media-cache-smoke.mjs && node ./scripts/password-reset-link-smoke.mjs",
    "test:birthday": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/birthday-reward-smoke.ps1",
    "test:auth": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/auth-regression-smoke.ps1",
    "test:webpush": "node ./scripts/webpush-payload-smoke.mjs",
    "test:promotion-media": "node ./scripts/promotion-media-cache-smoke.mjs",
    "test:reset-link": "node ./scripts/password-reset-link-smoke.mjs",
    "test:native-api": "node ./scripts/native-api-smoke.mjs",
    "test:native-auth": "node ./scripts/native-auth-client-smoke.mjs",
    "test:native-routing": "node ./scripts/native-routing-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fives-rewards-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fives-rewards-db --remote",
    "db:menu:reconcile:local": "node ./scripts/reconcile-real-menu.mjs --local",
    "db:menu:reconcile:remote": "node ./scripts/reconcile-real-menu.mjs --remote",
    "db:seed:local": "curl -s -X POST http://localhost:5173/api/dev/seed",
    "auth:generate": "auth generate --config auth.ts --output worker/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.39.0",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-qr-code": "^2.2.0",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.128.0"
  }
}
