{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fives-rewards",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	"observability": {
		"enabled": true
	},

	"triggers": {
		"crons": ["10 22 * * *", "*/5 * * * *"]
	},

	"vars": {
		"APP_ENV": "development",
		"BUSINESS_SLUG": "fives-pub-and-grill",
		"NATIVE_APP_ORIGINS": "https://app.fivessportsbar.app",
		"TURNSTILE_ALLOWED_HOSTNAMES": "fivessportsbar.app,app.fivessportsbar.app"
	},

	// Top-level bindings are for local dev only. Never use them for production.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fives-rewards-db",
			"database_id": "e1d41192-7b5b-47b1-9a61-65bdf43a2e8b",
			"migrations_dir": "drizzle/migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "fives-rewards-media-local"
		}
	],

	"send_email": [
		{
			"name": "EMAIL"
		}
	],

	"env": {
		"production": {
			"workers_dev": false,
			"triggers": {
				"crons": ["10 22 * * *", "*/5 * * * *"]
			},
			"vars": {
				"APP_ENV": "production",
				"BUSINESS_SLUG": "fives-pub-and-grill",
				"NATIVE_APP_ORIGINS": "https://app.fivessportsbar.app",
				"TURNSTILE_ALLOWED_HOSTNAMES": "fivessportsbar.app,app.fivessportsbar.app"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fives-rewards-db",
					"database_id": "e1d41192-7b5b-47b1-9a61-65bdf43a2e8b",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "fives-rewards-media"
				}
			],
			"send_email": [
				{
					"name": "EMAIL"
				}
			]
		}
	}
}
