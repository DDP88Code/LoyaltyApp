{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fives-rewards",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},

	"observability": {
		"enabled": true
	},

	"vars": {
		"APP_ENV": "development",
		"BUSINESS_SLUG": "fives-pub-and-grill"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fives-rewards-db",
			"database_id": "e1d41192-7b5b-47b1-9a61-65bdf43a2e8b",
			"migrations_dir": "drizzle/migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "fives-rewards-media"
		}
	]
}
